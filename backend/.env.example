# Fill locally. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://cab_booking_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/cab_booking_dev
TEST_DATABASE_URL=postgresql+psycopg://cab_booking_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/cab_booking_test
# Generate a random value with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS_LONG
# False only for local HTTP development. Use True with HTTPS when deployed.
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=30

# Free OSRM demo for learning. Use your own routing host before public production use.
OSRM_BASE_URL=https://router.project-osrm.org
QUOTE_LIFETIME_SECONDS=300
# Illustrative project fares in INR, not prices from a real cab operator.
FARE_BASE=50.00
FARE_PER_KM=12.00
FARE_PER_MINUTE=1.00
FARE_MINIMUM=80.00
# Day 4: nearby matching in meters; online locations expire unless refreshed.
MATCHING_RADIUS_METERS=5000
DRIVER_LOCATION_MAX_AGE_SECONDS=300

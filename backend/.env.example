# Fill locally. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://cab_booking_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/cab_booking_dev
TEST_DATABASE_URL=postgresql+psycopg://cab_booking_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/cab_booking_test
# Generate a random value with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS_LONG
# False only for local HTTP development. Use True with HTTPS when deployed.
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=30

# Free OSRM demo for learning. Use your own routing host before public production use.
OSRM_BASE_URL=https://router.project-osrm.org
QUOTE_LIFETIME_SECONDS=300
# Illustrative project fares in INR, not prices from a real cab operator.
FARE_BASE=50.00
FARE_PER_KM=12.00
FARE_PER_MINUTE=1.00
FARE_MINIMUM=80.00
# Day 4: nearby matching in meters; online locations expire unless refreshed.
MATCHING_RADIUS_METERS=5000
DRIVER_LOCATION_MAX_AGE_SECONDS=300

# Day 5: local Redis Pub/Sub. Use authenticated rediss:// with TLS when deployed.
REDIS_URL=redis://127.0.0.1:6379/0
# Day 12: required for shared quotas; protected requests return 503 if Redis fails.
RATE_LIMIT_PREFIX=cab_booking:limits:v1
MAX_REQUEST_BODY_BYTES=65536
# Explicit browser origins only; no wildcard, credentials or URL paths.
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
REALTIME_CHANNEL_PREFIX=cab_booking:realtime:v1
WEBSOCKET_SESSION_CHECK_SECONDS=2
WEBSOCKET_SYNC_SECONDS=15

# Day 6: optional until you configure a Stripe sandbox. Never use live keys.
# Keep these commented until replacing all three placeholders with your own values.
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SANDBOX_SECRET
# STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_SANDBOX_PUBLISHABLE_KEY
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_LOCAL_LISTENER_SECRET

# Day 8: disabled until explicitly configured. Local catcher never forwards mail.
RECEIPT_EMAIL_ENABLED=false
# Optional dedicated broker; defaults to REDIS_URL, with namespaced task keys.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_KEY_PREFIX=cab_booking:tasks:v1:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# False only for a loopback mail catcher. Remote SMTP requires STARTTLS.
SMTP_STARTTLS=false
SMTP_FROM=receipts@example.com
# SMTP_USERNAME=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_PRIVATE_SMTP_PASSWORD
